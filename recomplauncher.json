{
  "$schema": "https://raw.githubusercontent.com/elripalda/RecompLauncher-SDK/main/schema/recomplauncher.json",
  "format": 1,
  "name": "Orta Recompiled",
  "repo": "almost-drowned-rat/Orta-Recompiled",
  "inputs": [
    {
      "id": "game",
      "label": "Your disc image (.iso) of Panzer Dragoon Orta for the original Xbox, Europe (PAL) release.",
      "formats": [{ "type": "file" }],
      "check": { "xdvdfs": "default.xbe" }
    }
  ],
  "prepare": {
    "program": ["orta_launcher.exe", "Panzer_Dragoon_Orta_Recomp-x86_64.AppImage", "orta_launcher"],
    "args": ["--image", "{input:game}", "--no-start"],
    "label": "Translating and compiling the game for your PC (a few minutes, only once)",
    "keeps_copy": true,
    "done": ["{install}/data/build/stamp.txt", "{install}/game/default.xbe"]
  },
  "start": {
    "program": ["orta_launcher.exe", "Panzer_Dragoon_Orta_Recomp-x86_64.AppImage", "orta_launcher"]
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [{ "path": "{install}/saves/settings.ini" }]
    }
  ],
  "folders": {
    "saves": [{ "path": "{install}/saves" }],
    "logs": [{ "path": "{install}/data" }],
    "media": [{ "path": "{install}/media" }]
  },
  "system": {
    "windows": { "version": "10", "graphics": { "vulkan": "1.3" } },
    "linux": { "glibc": "2.35", "graphics": { "vulkan": "1.3" } }
  },
  "settings": [
    {
      "id": "display_mode", "label": "Display mode",
      "help": "Borderless fills your screen and lets you switch apps quickly. Fullscreen gives the game the screen to itself. Windowed remembers its size and place.",
      "choices": [
        { "label": "Borderless", "set": { "display_mode": "borderless" } },
        { "label": "Fullscreen", "set": { "display_mode": "fullscreen" } },
        { "label": "Windowed", "set": { "display_mode": "windowed" } }
      ],
      "defaults": { "display_mode": "borderless" }
    },
    {
      "id": "aspect_ratio", "label": "Aspect ratio",
      "choices": [
        { "label": "4:3", "set": { "aspect_ratio": "4:3" } },
        { "label": "16:9", "set": { "aspect_ratio": "16:9" } },
        { "label": "16:10", "set": { "aspect_ratio": "16:10" } },
        { "label": "21:9", "set": { "aspect_ratio": "21:9" } }
      ],
      "defaults": { "aspect_ratio": "4:3" }
    },
    {
      "id": "vsync", "label": "VSync",
      "choices": [
        { "label": "On", "set": { "vsync": "on" } },
        { "label": "Off", "set": { "vsync": "off" } }
      ],
      "defaults": { "vsync": "on" }
    },
    {
      "id": "upscaling", "label": "Upscaling",
      "help": "AMD FSR 1.0 sharpens the picture as it is fitted to your screen.",
      "choices": [
        { "label": "Bilinear", "set": { "upscaling": "bilinear" } },
        { "label": "FSR", "set": { "upscaling": "fsr" } }
      ],
      "defaults": { "upscaling": "bilinear" }
    },
    {
      "id": "shader_compile", "label": "Shader compile", "advanced": true,
      "help": "Hybrid draws with a general shader until the exact one is built: no waiting, nothing missing.",
      "choices": [
        { "label": "Hybrid", "set": { "shader_compile": "hybrid" } },
        { "label": "Wait", "set": { "shader_compile": "wait" } },
        { "label": "Skip", "set": { "shader_compile": "skip" } },
        { "label": "Off", "set": { "shader_compile": "off" } }
      ],
      "defaults": { "shader_compile": "hybrid" }
    }
  ],
  "actions": [
    { "id": "saves", "label": "Saves", "help": "Your saves and the port's settings.", "open": "saves" },
    { "id": "media", "label": "Boot video", "help": "Your own boot animation (see README.txt there).", "open": "media" }
  ]
}
