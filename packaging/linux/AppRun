#!/bin/sh
# AppRun - entry of the Panzer Dragoon Orta Recomp AppImage (v1.1.0 Linux port).
# The AppImage runtime mounts the image read-only and sets $APPIMAGE (the .AppImage file) and $APPDIR (the mount).
# Everything the player keeps (game/, saves/, media/, data/) lives in the folder that holds the .AppImage file -
# the toolkit's xbox_host_root() (platform/host_paths.h) - never in the mount and never in $HOME.
HERE="$(dirname "$(readlink -f "$0")")"
exec "$HERE/usr/bin/panzer-dragoon-orta-recomp" "$@"
